;;;; examples/cli/double.lasm
;;;; double(21) with the argument on the stack (#113):
;;;;
;;;;   lasm run double.lasm -m callfoo.lisp

(:program (:backend callfoo-abi)
  (:label main)
  (push (imm 21))
  (:op :call double)
  (adds (sp) (imm 1))
  (hlt)

  (:label double)
  (lds (reg a) (sp-idx 1))
  (:op :add (reg a) (reg a))
  (:op :return))
